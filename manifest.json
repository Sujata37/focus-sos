{
  "manifest_version": 3,
  "name": "Focus Coach",
  "version": "1.0.0",
  "description": "Stay focused: set a plan, whitelist sites, get nudges if you drift.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Focus Coach"
  },
  "options_page": "options.html",
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "scripting",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
